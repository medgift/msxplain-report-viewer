# Docker User Configuration
# Set these to match your host user to avoid permission issues
# Run: id -u && id -g to get your values
UID=1000
GID=1000

# ── CORS ────────────────────────────────────────────────────────────────
# The single public origin (comma-separated if several). Credentialed CORS is
# enabled ONLY for an explicit origin — never for "*" (the backend refuses to
# reflect arbitrary origins with credentials). Leave unset/"*" only for a
# same-origin or bearer-only dev setup, where credentialed CORS is disabled.
CORS_ORIGINS=https://msxplain.ehealth.hevs.ch

# ── Public deployment (Traefik) ─────────────────────────────────────────
# Used only by docker-compose.prod.yml.
TRAEFIK_NETWORK=prod
TRAEFIK_URL=msxplain.ehealth.hevs.ch
# Public base URL the browser uses (GoTrue site/redirect URL).
PUBLIC_URL=https://msxplain.ehealth.hevs.ch
# Keeps router/volume names namespaced on the shared host.
COMPOSE_PROJECT_NAME=msxplain

# ── Supabase (self-hosted: Postgres + GoTrue auth) ──────────────────────
# Generate strong values before going public (do NOT reuse these defaults).
POSTGRES_PASSWORD=change-me-strong-postgres-password
# 32+ char secret, IDENTICAL in GoTrue and the backend. Never rotate once
# data exists (it would invalidate all sessions and derived keys). REQUIRED:
# the stack refuses to start if unset or left at the public demo value.
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# HS256 JWTs signed with JWT_SECRET (aud "anon" / "service_role"). Generate
# with the Supabase key generator. ANON_KEY is public (frontend); the
# SERVICE_ROLE_KEY is backend-only (admin API for seeding users).
ANON_KEY=
SERVICE_ROLE_KEY=

# Injected into the frontend build (public). Leave URL blank to use the
# current origin (works behind the nginx /auth proxy).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Session lifetime (Go duration strings, e.g. "30m", "8h"). Defaults: logged
# out after 3h of inactivity, forced re-login after 12h regardless.
#SESSIONS_INACTIVITY_TIMEOUT=3h
#SESSIONS_TIMEBOX=12h

# ── Orthanc (internal PACS) ─────────────────────────────────────────────
# Orthanc is NEVER exposed to users: it has no published ports in prod, and the
# only way in is the backend's read-only DICOMweb proxy (/api/dicom-web), which
# the OHIF viewer uses. Admin access (you) is via SSH tunnel / docker exec only.
#
# Setting BOTH of these turns on Orthanc's own HTTP auth (defense-in-depth) and
# lets the backend authenticate to it — no config edit needed. STRONGLY
# recommended in prod. Leave unset for local dev (auth stays off).
ORTHANC_USERNAME=orthanc-admin
ORTHANC_PASSWORD=change-me-strong-orthanc-password

# ── Backups (prod only) ─────────────────────────────────────────────────
DB_BACKUP_DIRECTORY=./backups/db
DATA_BACKUP_DIRECTORY=./backups/data
