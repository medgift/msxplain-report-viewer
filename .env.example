# Docker User Configuration
# Set these to match your host user to avoid permission issues
# Run: id -u && id -g to get your values
UID=1000
GID=1000

# Port Configuration (optional - defaults are shown)
FRONTEND_PORT=3001
BACKEND_PORT=5000
ORTHANC_HTTP_PORT=8042
ORTHANC_DICOM_PORT=4242

# CORS Configuration
# For production: specify exact origins (comma-separated)
# Example: CORS_ORIGINS=http://131.152.136.12:3001,http://localhost:3001
# For development/internal: use * to allow all
CORS_ORIGINS=*
