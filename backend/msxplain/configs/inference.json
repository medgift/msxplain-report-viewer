{
  "imports": ["$import glob", "$import os"],
  "bundle_root": ".",
  "ckpt_dir": "$@bundle_root + '/models'",
  "output_dir": "$@bundle_root + '/eval'",
  "data_list_file_path": "$@bundle_root + '/configs/datalist.json'",
  "dataset_dir": "/path/to/dataset",
  "device": "$torch.device('cpu')",
  "amp": true,
  "network_def": {
    "_target_": "UNet",
    "spatial_dims": 3,
    "in_channels": 2,
    "out_channels": 2,
    "channels": [32, 64, 128, 256, 512],
    "strides": [2, 2, 2, 2],
    "num_res_units": 0,
    "norm": "batch"
  },
  "network": "$@network_def.to(@device)",
  "preprocessing": {
    "_target_": "Compose",
    "transforms": [
      {
        "_target_": "LoadImaged",
        "keys": ["flair", "mprage"]
      },
      {
        "_target_": "AddChanneld",
        "keys": ["flair", "mprage"]
      },
      {
        "_target_": "NormalizeIntensityd",
        "keys": ["flair", "mprage"],
        "nonzero": true,
        "channel_wise": true
      },
      {
        "_target_": "ConcatItemsd",
        "keys": ["flair", "mprage"],
        "name": "inputs"
      },
      {
        "_target_": "DeleteItemsd",
        "keys": ["flair", "mprage"]
      }
    ]
  },
  "dataset": {
    "_target_": "Dataset",
    "transform": "@preprocessing"
  },
  "dataloader": {
    "_target_": "DataLoader",
    "dataset": "@dataset",
    "batch_size": 1,
    "shuffle": false,
    "num_workers": 4
  },
  "inferer": {
    "_target_": "SlidingWindowInferer",
    "roi_size": [96, 96, 96],
    "sw_batch_size": 4,
    "mode": "gaussian",
    "overlap": 0.25
  },
  "postprocessing": {
    "_target_": "Compose",
    "transforms": [
      {
        "_target_": "Activationsd",
        "keys": "pred",
        "softmax": true,
        "kwargs": { "dim": 1 }
      },
      {
        "_target_": "AsDiscreted",
        "keys": "pred",
        "threshold": 0.4
      },
      {
        "_target_": "Lambdad",
        "_desc_": "Discard background channel and keep only WML channel",
        "keys": "pred",
        "func": "$lambda x: x[1:, :, :, :]"
      },
      {
        "_target_": "SaveImaged",
        "keys": "pred",
        "meta_keys": "pred_meta_dict",
        "output_dir": "@output_dir",
        "output_postfix": "seg",
        "output_dtype": "uint8",
        "resample": false,
        "squeeze_end_dims": true
      }
    ]
  },
  "handlers": [
    {
      "_target_": "CheckpointLoader",
      "load_path": "$@bundle_root + '/model/model.pt'",
      "load_dict": {
        "model": "@network"
      }
    },
    {
      "_target_": "StatsHandler",
      "iteration_log": false
    }
  ],
  "evaluator": {
    "_target_": "SupervisedEvaluator",
    "device": "@device",
    "val_data_loader": "@dataloader",
    "network": "@network",
    "inferer": "@inferer",
    "postprocessing": "@postprocessing",
    "val_handlers": "@handlers",
    "amp": true
  },
  "evaluating": [
    "$setattr(torch.backends.cudnn, 'benchmark', True)",
    "$@evaluator.run()"
  ]
}
